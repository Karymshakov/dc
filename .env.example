# Скопируйте в .env и подставьте свой токен от @BotFather.
# Файл .env в репозиторий не попадает — см. .gitignore.
TELEGRAM_BOT_TOKEN=123456789:AA...

# Ключ Gemini для бонуса с голосовыми сообщениями. Нужен только боту,
# функция answer() от него не зависит.
GEMINI_API_KEY=AQ...

# Чат или группа операторов: туда падают обращения, оттуда приходят ответы.
# Не задан — передача оператору работает как раньше, просто без пересылки.
OPERATOR_CHAT_ID=-100...

# Пароль первого администратора CRM (логин admin). Применяется, только пока
# в базе CRM нет ни одного администратора. Не задан — admin123!.
# Операторов администратор заводит сам в разделе «Операторы».
CRM_ADMIN_PASSWORD=
# CRM_HOST=127.0.0.1
# CRM_PORT=8765
# CRM_RETENTION_DAYS=30
